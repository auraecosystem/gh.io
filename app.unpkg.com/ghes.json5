                },
                "examples": {
                  "default": {
                    "$ref": "#/components/examples/root"
                  }
                }
              }
            }
          }
        },
        "x-github": {
          "githubCloudOnly": false,
          "enabledForGitHubApps": true,
          "category": "meta",
          "subcategory": "meta"
        },
        "externalDocs": {
          "description": "API method documentation",
          "url": "https://docs.github.com/enterprise-server@3.19/rest/meta/meta#github-api-root"
        },
        "x-octokit": {}
      }
